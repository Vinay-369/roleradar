# ==============================================================================
# RoleRadar Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env) and populate secrets before running.

# --- Application Environment ---
ENV=development
DEBUG=true
API_PREFIX=/api

# --- CORS Settings ---
# JSON array of origins permitted to make cross-origin requests
CORS_ORIGINS=["http://localhost:5173"]

# --- Authentication & Security ---
# In production (ENV=production), JWT_SECRET must be at least 16 random characters
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Rate Limiting ---
RATE_LIMITING_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=roleradar

# --- File Storage ---
UPLOAD_DIR=./storage/uploads
GENERATED_DIR=./storage/generated
MAX_UPLOAD_MB=5

# --- Runtime AI Provider ---
# Select active provider: "ollama" | "lmstudio" | "cloud_fallback"
AI_PROVIDER=ollama

# Local Ollama Configuration (Default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini:latest
# OLLAMA_CHAT_MODEL=

# Local LM Studio Configuration (Optional Alternative)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Cloud LLM Fallback (Used when AI_PROVIDER=cloud_fallback)
CLOUD_FALLBACK_PROVIDER=gemini
CLOUD_FALLBACK_API_KEY=
CLOUD_FALLBACK_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=300
AI_MAX_RETRIES=2

# --- Opportunity & Job Feed Configuration ---
# "curated": internal curated benchmark (default, works with zero external config)
# "hybrid": also fetches live listings from Adzuna aggregator
JOB_SOURCE_MODE=curated
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_RESULTS_PER_QUERY=30

# Semantic Matching Embeddings
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Direct Employer ATS Provider Integrations ---
# Greenhouse ATS
GREENHOUSE_ENABLED=true
GREENHOUSE_COMPANIES=postman,inmobi,groww,figma,airbnb,stripe
GREENHOUSE_REQUEST_TIMEOUT_SECONDS=15
MAX_VERIFICATION_AGE_HOURS=48

# Lever ATS
LEVER_ENABLED=true
LEVER_COMPANIES=paytm,meesho,cred,fi
LEVER_REQUEST_TIMEOUT_SECONDS=15

# SmartRecruiters ATS
SMARTRECRUITERS_ENABLED=true
SMARTRECRUITERS_COMPANIES=BoschGroup,Sandisk,AveryDennison,BlueberryLabsPrivateLimited,Ubisoft2
SMARTRECRUITERS_REQUEST_TIMEOUT_SECONDS=15
SMARTRECRUITERS_COUNTRY=in

# Ashby ATS
ASHBY_ENABLED=true
ASHBY_COMPANIES=kong,aiprise,cartesia,lambda,harvey,temporal,elevenlabs
ASHBY_REQUEST_TIMEOUT_SECONDS=15
