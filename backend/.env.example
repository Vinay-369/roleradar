# --- App ---
ENV=development
DEBUG=true

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=roleradar

# --- Runtime AI: default is local Ollama, no key required ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Alternative local runtime (use instead of Ollama if preferred) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# --- Optional cloud fallback (only used if AI_PROVIDER=cloud_fallback) ---
CLOUD_FALLBACK_PROVIDER=gemini
CLOUD_FALLBACK_API_KEY=
CLOUD_FALLBACK_MODEL=gemini-2.0-flash

# --- Job sources: default "curated" needs zero setup and always works.
# Set to "hybrid" + add real Adzuna credentials to also pull in real,
# live job listings with real apply links (free signup at
# https://developer.adzuna.com/signup). Untested against the live API
# by the AI that built this — verify it works before relying on it.
JOB_SOURCE_MODE=curated
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
